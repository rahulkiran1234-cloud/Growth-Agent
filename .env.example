# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Supabase -> Project Settings -> Database -> Connection string (Session pooler)
DATABASE_URL=

# Models (dev = haiku for cheap iteration, switch to sonnet for final demos)
LLM_MODEL_STEPS=claude-haiku-4-5-20251001
LLM_MODEL_FAST=claude-haiku-4-5-20251001

# Cost guards
MAX_TOKENS_PER_ANALYSIS=250000
MAX_AGENT_LOOP_ITERATIONS=12

# Free tier: analyses per project (0 = unlimited). Failed runs don't count.
FREE_ANALYSES_LIMIT=3
# Max analyses running at once on this server (protects the AI budget)
MAX_CONCURRENT_ANALYSES=3
# Optional: path to Edge/Chrome for PDF export (auto-detected otherwise)
# PDF_BROWSER_PATH=

# Optional: signs the short-lived PDF export link. Any long random string. Falls back to DATABASE_URL if unset.
AUTH_SECRET=

# Password reset emails (all optional). Without SMTP settings, reset links are printed in the server terminal
# during development, so "Forgot password" still works on your laptop. In production APP_URL is required.
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
